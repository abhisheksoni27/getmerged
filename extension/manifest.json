{
  "manifest_version": 3,
  "name": "OpenDoor: Contribution Readiness for GitHub",
  "version": "1.0.0",
  "description": "Injects live OpenDoor C-Rank telemetry, review velocity stats and Good First Issue tags into GitHub repo headers and PR pages, with a 1-click deeplink to full repo telemetry on OpenDoor.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://github.com/*",
    "https://api.opendoor.dev/*",
    "https://opendoor.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["polyfill/browser-polyfill.min.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "opendoor-github@opendoor.dev",
      "strict_min_version": "113.0"
    }
  }
}
