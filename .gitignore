# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

*.db
tmp/
*.log
bin/

.code-review-graph

.playwright-cli
.baseline-screens/
.claude
backend/server
.agents
*.db*
bkp.env
# Local build artifacts / scratch (backend)
backend/backfill
backend/generate_ai_insights
backend/insights_comments_v2.json
backend/recalculate-history
backend/eventstream
backend/gharchive
backend/generate_sitemap

# Dependencies
node_modules/

# Python caches & bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Backups, swaps & temporary files
*.bak
*.swp
*~

# Agent / Tool scratch directories & configs
.kilo/
.commandcode/
.hermes/
.playwright/
.opencode.json
opencode.jsonc
skills-lock.json
gitleaks-report.json

# OS & Environment
.DS_Store
Thumbs.db

# Test artifacts
test-results/
playwright-report/

# Audit dumps & scratch reports
*-audit/
report.json

