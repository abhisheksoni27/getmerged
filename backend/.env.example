# GitHub
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database
# Local dev (SQLite file):
DATABASE_URL=./opendoor.db
# Prod Turso:
# DATABASE_URL=libsql://your-db.turso.io?authToken=your-token

# Cache
# Local dev (Docker Valkey):
VALKEY_URL=localhost:6379
VALKEY_PASSWORD=
# Prod Aiven Valkey:
# VALKEY_URL=your-aiven-host:port
# VALKEY_PASSWORD=your-aiven-password

# Auth
# INTERNAL_API_KEY — generate with: openssl rand -base64 192 (min 256 chars)
INTERNAL_API_KEY=
# JWT_SECRET — generate with: openssl rand -base64 32 (min 32 chars)
JWT_SECRET=
# ENCRYPTION_KEY — generate with: openssl rand -hex 16 (min 32 chars for AES-256-GCM)
ENCRYPTION_KEY=

# AI Insights (Opencode API)
OPENCODE_API_KEY=

# Logging
# debug | info | warn | error
LOG_LEVEL=info
LOG_FILE=opendoor.log

# Discovery & retention
# Discovery sweeps one (language, stars) bucket per run; defaults below are safe.
DISCOVERY_INTERVAL_MINUTES=15
DISCOVERY_MAX_NEW_PER_RUN=10
SNAPSHOT_RETENTION_DAYS=90

# Server
PORT=8080
GIN_MODE=debug
# GIN_MODE=release
